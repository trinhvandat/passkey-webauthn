# Sample Environment Configuration
# Copy this file to .env and update with your actual values
# cp sample.env .env

# ===================
# Database Configuration
# ===================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=web-authn
DB_USER=web-authn
DB_PASSWORD=your-database-password

# ===================
# Database Migration
# ===================
MIGRATION_ENABLED=true

# ===================
# PgAdmin (Docker)
# ===================
DB_GUI_PORT=18080
DB_GUI_ADMIN_EMAIL=admin@example.com
DB_GUI_ADMIN_PASSWORD=admin

# ===================
# JWT Configuration
# ===================
# Secret key for signing JWT tokens (minimum 256 bits / 32 characters)
JWT_SECRET=your-jwt-secret-key-at-least-256-bits-long-for-security

# ===================
# OAuth 2.0 - Google
# ===================
# Get credentials from: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/oauth/callback/google
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===================
# OAuth 2.0 - GitHub
# ===================
# Get credentials from: https://github.com/settings/developers
# Callback URL: http://localhost:3000/oauth/callback/github
GITHUB_OAUTH_ENABLED=false
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
